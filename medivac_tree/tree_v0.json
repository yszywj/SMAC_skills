{
  "schema_version": 1,
  "feature_schema_version": 1,
  "version": "medivac-direct-v0",
  "description": "Simplified action-tree initialization; not behavior-equivalent to the old scored joint controller. Ground actions are outside its scope.",
  "parameters": {},
  "root": {
    "id": "alive", "feature": "alive", "op": "==", "threshold": true,
    "no": {"id": "dead", "intent": "NOOP"},
    "yes": {
      "id": "danger", "feature": "can_retreat", "op": "==", "threshold": true,
      "yes": {"id": "retreat", "intent": "RETREAT"},
      "no": {
        "id": "rescue", "feature": "has_rescue", "op": "==", "threshold": true,
        "yes": {"id": "rescue_heal", "intent": "HEAL_RESCUE"},
        "no": {
          "id": "keep", "feature": "can_keep", "op": "==", "threshold": true,
          "yes": {"id": "preserve", "intent": "KEEP_HEAL"},
          "no": {
            "id": "current", "feature": "has_current", "op": "==", "threshold": true,
            "yes": {"id": "current_heal", "intent": "HEAL_CURRENT"},
            "no": {
              "id": "new_patient", "feature": "has_new", "op": "==", "threshold": true,
              "yes": {"id": "new_heal", "intent": "HEAL_NEW"},
              "no": {
                "id": "approach_patient", "feature": "has_approach", "op": "==", "threshold": true,
                "yes": {"id": "approach", "intent": "APPROACH"},
                "no": {
                  "id": "support_move", "feature": "has_support_move", "op": "==", "threshold": true,
                  "yes": {"id": "support", "intent": "SUPPORT"},
                  "no": {"id": "stop", "intent": "STOP"}
                }
              }
            }
          }
        }
      }
    }
  }
}
